# Copy to config.env and edit.
# Values are consumed by setup_from_config.sh to run checks and sam deploy.

APP_NAME=phtracker
ENV=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
COGNITO_CALLBACK_URLS=http://localhost:5173/callback
COGNITO_LOGOUT_URLS=http://localhost:5173
SSM_JWT_AUDIENCE_PARAM=/phtracker/dev/jwt_audience
# Optional custom domain for the HTTP API. Leave blank to skip.
CUSTOM_DOMAIN_NAME=
CUSTOM_DOMAIN_CERT_ARN=
# Set to "true" to let setup_from_config.sh run sam build/deploy automatically.
RUN_DEPLOY=false
